# Copy to .env on the server: cp .env.example .env && chmod 600 .env
# Generate secrets with: openssl rand -base64 32 | tr -d '/+='

# --- Domains ---
DOMAIN=stepaniuk.me
WEBHOOKS_DOMAIN=webhooks.stepaniuk.me

# --- Traefik / Let's Encrypt ---
ACME_EMAIL=you@example.com

# --- Tailscale ---
# Host's Tailscale IPv4: run `tailscale ip -4` on the VPS
TAILSCALE_IP=100.x.x.x

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Redis ---
REDIS_PASSWORD=change-me
