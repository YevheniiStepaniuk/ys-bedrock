# Copy to .env on the server: cp .env.example .env && chmod 600 .env
# Generate secrets with: openssl rand -base64 32 | tr -d '/+='

# --- Domains ---
DOMAIN=stepaniuk.me
WEBHOOKS_DOMAIN=webhooks.stepaniuk.me

# --- Traefik / Let's Encrypt ---
ACME_EMAIL=you@example.com

# --- Tailscale ---
# Host's Tailscale IPv4: run `tailscale ip -4` on the VPS
TAILSCALE_IP=100.x.x.x

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Redis ---
REDIS_PASSWORD=change-me

# --- Monitoring (Beszel agent) ---
# Filled after first hub start: Beszel UI -> Add System -> copy Key + Token.
# Then uncomment COMPOSE_PROFILES to start the agent. See docs/monitoring.md.
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=
# COMPOSE_PROFILES=agent

# --- DB web UIs (pgweb, Redis Commander) — HTTP basic auth, Tailscale-only ---
TOOLS_USER=admin
TOOLS_PASSWORD=change-me

# --- Backups: Postgres -> Cloudflare R2 (see docs/backups.md) ---
# Enable by adding `backup` to COMPOSE_PROFILES, e.g. COMPOSE_PROFILES=agent,backup
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ys-backups
# Encrypts every dump (gpg AES256). STORE IT OUTSIDE THE VPS TOO (password manager) —
# without it backups are unrecoverable.
BACKUP_PASSPHRASE=change-me
# Daily run time, HH:MM UTC
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# Optional dead-man's switch, e.g. https://hc-ping.com/<uuid> (gets /start, /fail, success)
BACKUP_PING_URL=
